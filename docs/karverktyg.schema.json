{
  "$defs": {
    "Avdelning": {
      "description": "One avdelning's config: its meeting ``weekday`` and an optional explicit move\n``target`` — **never a troop_id** (resolved live from ``unit.raw_value``) and\nnever a bracket-specific transition. ``name`` and ``bracket`` may be declared\nhere or left to be inferred from the member data; declaring them lets an empty\nor brand-new avdelning exist before anyone is in it.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "bracket": {
          "$ref": "#/$defs/Bracket"
        },
        "weekday": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weekday"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "name",
        "bracket"
      ],
      "title": "Avdelning",
      "type": "object"
    },
    "Bracket": {
      "description": "Scout age brackets, keyed to Scoutnet unit_type.",
      "enum": [
        "sparare",
        "upptackare",
        "aventyrare",
        "utmanare",
        "rover",
        "annat"
      ],
      "title": "Bracket",
      "type": "string"
    },
    "ExpectedPost": {
      "description": "An expected förtroendeuppdrag, for the opt-in vacancy view (§18).\n\nStrictly opt-in: with no expected posts configured, no vacancies are\nreported and an unfilled post is never treated as an error.",
      "properties": {
        "role_key": {
          "title": "Role Key",
          "type": "string"
        },
        "count": {
          "default": 1,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "role_key"
      ],
      "title": "ExpectedPost",
      "type": "object"
    }
  },
  "description": "A kår's configuration (§13): a version, an optional display name, and the\navdelningar. Brackets are national (see ``BRACKETS``); the group id and every\navdelning's bracket/troop_id are inferred from the data when not declared.",
  "properties": {
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "avdelningar": {
      "items": {
        "$ref": "#/$defs/Avdelning"
      },
      "title": "Avdelningar",
      "type": "array"
    },
    "role_label_overrides": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Role Label Overrides",
      "type": "object"
    },
    "expected_fortroende": {
      "items": {
        "$ref": "#/$defs/ExpectedPost"
      },
      "title": "Expected Fortroende",
      "type": "array"
    }
  },
  "title": "karverktyg kår-config",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
