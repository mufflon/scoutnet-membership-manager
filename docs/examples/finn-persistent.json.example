  "$schema": "../karverktyg.schema.json",
  "_comment": "Finn with a single STANDING Utmanare avdelning (Finnfararna) that scouts move into each year, shown two ways: the sole-candidate rule would route to it automatically, and here Vikingarna also names it explicitly via 'target'.",
  "name": "Scoutkåren Finn (stående Utmanare)",
  "avdelningar": [
    { "name": "Hajarna",       "bracket": "sparare",    "weekday": 0 },
    { "name": "Späckhuggarna", "bracket": "sparare",    "weekday": 1 },
    { "name": "Rockorna",      "bracket": "sparare",    "weekday": 2 },
    { "name": "Kämparna",      "bracket": "upptackare", "weekday": 0 },
    { "name": "Spejarna",      "bracket": "upptackare", "weekday": 1 },
    { "name": "Utforskarna",   "bracket": "upptackare", "weekday": 2 },
    { "name": "Vikingarna",    "bracket": "aventyrare", "weekday": 3, "target": "Finnfararna" },
    { "name": "Finnfararna",   "bracket": "utmanare" },
    { "name": "Finness",       "bracket": "rover" },
