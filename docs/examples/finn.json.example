{
  "$schema": "../karverktyg.schema.json",
  "_comment": "The 'kar' block for Scoutkåren Finn — the same shape as the kar block inside karverktyg.json. Each avdelning: a bracket, an optional weekday (0=Mon..6=Sun) that drives the same-weekday move, and an optional target. Three Spårare and three Upptäckare on Mon/Tue/Wed, one Äventyrare, three Utmanare (built fresh each year).",
  "name": "Scoutkåren Finn",
  "avdelningar": [
    { "name": "Hajarna",       "bracket": "sparare",    "weekday": 0 },
    { "name": "Späckhuggarna", "bracket": "sparare",    "weekday": 1 },
    { "name": "Rockorna",      "bracket": "sparare",    "weekday": 2 },
    { "name": "Kämparna",      "bracket": "upptackare", "weekday": 0 },
    { "name": "Spejarna",      "bracket": "upptackare", "weekday": 1 },
    { "name": "Utforskarna",   "bracket": "upptackare", "weekday": 2 },
    { "name": "Vikingarna",    "bracket": "aventyrare", "weekday": 3 },
    { "name": "Finndus",       "bracket": "utmanare" },
    { "name": "Finnemang",     "bracket": "utmanare" },
    { "name": "Fniss",         "bracket": "utmanare" },
    { "name": "Finness",       "bracket": "rover" },
    { "name": "Finnurligt",    "bracket": "rover" },
    { "name": "Parafinn",      "bracket": "rover" },
    { "name": "Ledare",        "bracket": "annat" }
  ]
}
