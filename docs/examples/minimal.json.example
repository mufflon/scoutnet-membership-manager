{
  "$schema": "../karverktyg.schema.json",
  "_comment": "Smallest possible kår: one avdelning per bracket. Because each next bracket has exactly one avdelning, every move auto-resolves (sole candidate) with no weekday needed.",
  "name": "Exempelkåren (minimal)",
  "avdelningar": [
    { "name": "Spårarna",    "bracket": "sparare",    "weekday": 0 },
    { "name": "Upptäckarna", "bracket": "upptackare", "weekday": 0 },
    { "name": "Äventyrarna", "bracket": "aventyrare", "weekday": 0 },
    { "name": "Utmanarna",   "bracket": "utmanare" },
    { "name": "Rovers",      "bracket": "rover" },
    { "name": "Ledare",      "bracket": "annat" }
  ]
}
