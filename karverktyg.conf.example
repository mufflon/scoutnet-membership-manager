# karverktyg deploy config. Copy to karverktyg.conf, fill in, then:
#   scripts/k8s-up.sh karverktyg.conf
#
# A BLANK value means "not configured": that endpoint/action is disabled and the
# tool never uses it. Never commit a filled-in file — it holds live API keys.

# fixture    = no credentials, uses the committed sample data
# read_only  = live Scoutnet, reads only
# read_write = live Scoutnet, reads plus the controlled write path (needs the
#              write key and snapshot volume below); the UI shows a banner while active
SCOUTNET_MODE=fixture

# Internal entity id (the kår number for Finn). HTTP Basic username; required for
# read_only and read_write.
SCOUTNET_ENTITY_ID=1025

# Per-endpoint API keys (Din kår -> Webbkoppling). Each key authorises ONE
# endpoint; blank = that endpoint is unused.
#
# SCOUTNET_MEMBERLIST_KEY -> GET https://scoutnet.se/api/group/memberlist
SCOUTNET_MEMBERLIST_KEY=

# SCOUTNET_ORGANISATION_GROUP_KEY -> GET https://scoutnet.se/api/organisation/group
SCOUTNET_ORGANISATION_GROUP_KEY=

# Write key — only used when SCOUTNET_MODE=read_write.
# SCOUTNET_UPDATE_MEMBERSHIP_KEY -> POST https://scoutnet.se/api/organisation/update/membership
#   Loaded into the Kubernetes Secret at build-up; never entered in the app UI.
#   Blank = writing disabled.
SCOUTNET_UPDATE_MEMBERSHIP_KEY=

# Member numbers a write run may touch, as a JSON list. Shown in the app but only
# editable here. Keep it small while testing. Empty list = nothing may be written.
SCOUTNET_WRITE_ALLOWLIST=[]

# Volume path for pre-run snapshot files, used to reconcile and undo a run. Must
# point at a mounted volume so snapshots survive a pod restart. Holds no personal data.
SCOUTNET_SNAPSHOT_DIR=/var/lib/karverktyg/snapshots

# Members written per request (default 1) and seconds between requests.
SCOUTNET_CHUNK_SIZE=1
SCOUTNET_CHUNK_DELAY_S=1.0

# How long snapshots are kept, and therefore how long a run can be undone.
SCOUTNET_SNAPSHOT_RETENTION_DAYS=30

# Uppflyttning cohort year N. Blank = derive from the live term.
SCOUTNET_COHORT_YEAR=2026

# Kår identity.
SCOUTNET_KAR_NAME=Scoutkåren Finn

# Password for the in-cluster Postgres provisioned at build-up.
POSTGRES_PASSWORD=devpassword
