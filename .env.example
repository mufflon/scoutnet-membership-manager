# Copy to .env for local use. NEVER commit real keys (Hard rule #1).
# Env vars are prefixed SCOUTNET_ (pydantic-settings).

# Mode: fixture | read_only | read_write. Default read_only.
# fixture runs the whole app with no credentials and no network.
SCOUTNET_MODE=fixture

# Live credentials (needed for read_only / read_write only).
# Entity id is the internal id (== kår number for Finn, 1025).
#SCOUTNET_ENTITY_ID=1025
#SCOUTNET_MEMBERLIST_KEY=
#SCOUTNET_ORGANISATION_GROUP_KEY=
#SCOUTNET_BASE_URL=https://scoutnet.se/api

# Database (read_only / read_write). Fixture mode uses in-memory SQLite.
#SCOUTNET_DATABASE_URL=postgresql+psycopg://user:pass@localhost/karverktyg

# Uppflyttning cohort year N. Leave unset to derive from the live term
# (guarded by the config cross-check). Set explicitly in production.
#SCOUTNET_COHORT_YEAR=2026

# Kår identity (defaults to Scoutkåren Finn).
#SCOUTNET_KAR_NAME=Scoutkåren Finn
