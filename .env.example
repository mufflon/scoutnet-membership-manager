# Copy to .env for local use. NEVER commit real keys (Hard rule #1).
# Env vars are prefixed SCOUTNET_ (pydantic-settings).

# Mode: fixture | read_only | read_write. Default read_only.
# fixture runs the whole app with no credentials and no network.
SCOUTNET_MODE=fixture

# Live credentials (needed for read_only / read_write only).
# Entity id is the internal id (== kår number for Finn, 1025).
#SCOUTNET_ENTITY_ID=1025
#SCOUTNET_MEMBERLIST_KEY=
#SCOUTNET_ORGANISATION_GROUP_KEY=
#SCOUTNET_BASE_URL=https://scoutnet.se/api

# Write path (read_write mode ONLY). Its own per-endpoint key (§4). Setting
# SCOUTNET_MODE=read_write requires this key or the app fails loudly at startup.
#SCOUTNET_UPDATE_MEMBERSHIP_KEY=
# Member-number allowlist the stage-2 write verification may touch (§8).
# Non-secret, so its home is scoutnet-membership-manager.json ("write_allowlist": [...]);
# this env var still works as an override. Empty => nothing may be written (fail closed).
#SCOUTNET_WRITE_ALLOWLIST=["123456"]
# Full-memberlist snapshot volume, required before a bulk run (§8).
#SCOUTNET_SNAPSHOT_DIR=/var/lib/scoutnet-membership-manager/snapshots
# Chunking (§8): default 1 needs no atomicity guarantee. Raise only with evidence.
#SCOUTNET_CHUNK_SIZE=1
#SCOUTNET_CHUNK_DELAY_S=1.0

# Database (read_only / read_write). Fixture mode uses in-memory SQLite.
#SCOUTNET_DATABASE_URL=postgresql+psycopg://user:pass@localhost/scoutnet-membership-manager

# Uppflyttning cohort year N. Leave unset to derive from the live term
# (guarded by the config cross-check). Set explicitly in production.
#SCOUTNET_COHORT_YEAR=2026

# Kår identity (defaults to Scoutkåren Finn).
#SCOUTNET_KAR_NAME=Scoutkåren Finn
